+
+// ----- Terrain editor undo history -----
+// Every brush stroke records the tiles it changed, so the editor can step back. Kept in memory only:
+// a restart starts with an empty history, the world itself stays as it was saved.
+struct TerrainEditTile
+{
+	int iMap;
+	short x, y;
+	word wId;
+	int8 z;
+	bool fOverlay;	// true: wId zemin değil, serpme katmanının eski değeri
+};
+
+static std::vector<std::vector<TerrainEditTile>> s_TerrainUndo;
+static int64 s_iTerrainNextSave = 0;	// the edits are written out at most this often
+#define TERRAIN_UNDO_MAX_STROKES	40
+
+
+// Deterministic 0..1 "random" value for a tile, so that a soft brush edge keeps the same dithering
+// pattern when the same spot is painted again instead of flickering.
+static float TerrainEditNoise(int x, int y) noexcept
+{
+	uint uiHash = (uint)((x * 73856093) ^ (y * 19349663));
+	uiHash ^= (uiHash >> 13);
+	uiHash *= 0x85EBCA6Bu;
+	uiHash ^= (uiHash >> 16);
+	return (float)(uiHash & 0xFFFFu) / 65535.0f;
+}
+
+int CWorldMap::EditStaticArea(const CPointMap& ptCenter, CChar* pChar, dword dwItemId, int iRadius, bool fSquare,
+	int iDensity, int iShape, bool fErase) // static
+{
+	ADDTOCALLSTACK("CWorldMap::EditStaticArea");
+	// The decoration brush: scatters items (trees, rocks, debris) over the brushed area, or removes the
+	// ones it placed. Everything it drops carries the tag "terrainedit", so the eraser can tell our own
+	// decoration apart from things players or scripts put there and never deletes those.
+	if (!ptCenter.IsValidPoint() || (pChar == nullptr))
+		return 0;
+
+	iRadius = maximum(0, minimum(TERRAIN_BRUSH_MAX_RADIUS, iRadius));
+	iDensity = maximum(1, minimum(100, iDensity));
+	iShape = ((iShape >= 0) && (iShape < TERRAIN_SHAPE_QTY)) ? iShape : TERRAIN_SHAPE_ROUND;
+
+	const int iMap = ptCenter.m_map;
+	const float fRadius = (float)iRadius + 0.5f;
+	const float fCore = fRadius;	// the decoration brush has no soft edge of its own, density does that
+	int iDone = 0;
+
+	for (int dy = -iRadius; dy <= iRadius; ++dy)
+	{
+		for (int dx = -iRadius; dx <= iRadius; ++dx)
+		{
+			const float fWeight = TerrainBrushWeight(iShape, (float)dx, (float)dy, fRadius, fCore, fSquare,
+				ptCenter.m_x + dx, ptCenter.m_y + dy);
+
+			if (fWeight <= 0.0f)
+				continue;
+
+			CPointMap pt((short)(ptCenter.m_x + dx), (short)(ptCenter.m_y + dy), 0, (uchar)iMap);
+			if (!pt.IsValidPoint())
+				continue;
+
+			if (fErase)
+			{
+				// Remove what the brush put here before.
+				auto pArea = CWorldSearchHolder::GetInstance(pt, 0);
+				for (;;)
+				{
+					CItem* pItem = pArea->GetItem();
+					if (pItem == nullptr)
+						break;
+					if (!pItem->m_TagDefs.GetKeyNum("terrainedit"))
+						continue;
+
+					pItem->Delete();
+					++iDone;
+				}
+
+				continue;
+			}
+
+			// Scatter: the density is the chance of a tile getting one, the brush shape thins the edge.
+			const float fChance = ((float)iDensity / 100.0f) * fWeight;
+			if (TerrainEditNoise(pt.m_x * 7, pt.m_y * 7) > fChance)
+				continue;
+
+			// Sit it on the ground.
+			uint64 uiBlockFlags = 0;
+			pt.m_z = GetHeightPoint2(pt, uiBlockFlags, true);
+
+			CItem* pItem = CItem::CreateScript((ITEMID_TYPE)dwItemId, pChar);
+			if (pItem == nullptr)
+				continue;
+
+			pItem->SetAttr(ATTR_MOVE_NEVER | ATTR_DECAY);
+			pItem->ClrAttr(ATTR_CAN_DECAY);
+			pItem->m_TagDefs.SetNum("terrainedit", 1);
+			pItem->MoveToUpdate(pt);
+			++iDone;
+		}
+	}
+
+	return iDone;
+}
+int CWorldMap::UndoTerrainStroke() // static
+{
+	ADDTOCALLSTACK("CWorldMap::UndoTerrainStroke");
+	// Puts back the tiles of the last stroke and pushes the blocks to the clients.
+	if (s_TerrainUndo.empty())
+		return 0;
+
+	const std::vector<TerrainEditTile> vecStroke = std::move(s_TerrainUndo.back());
+	s_TerrainUndo.pop_back();
+
+	std::set<dword> setDirtyBlocks;
+	std::set<dword> setDirtyOverlayBlocks;
+	int iRestored = 0;
+	const int iUndoMap = vecStroke.empty() ? 0 : vecStroke.front().iMap;
+
+	for (const TerrainEditTile& tile : vecStroke)
+	{
+		const CPointMap pt(tile.x, tile.y, 0, (uchar)(tile.iMap));
+		const int iBYMax = g_MapList.GetMapSizeY(tile.iMap) / UO_BLOCK_SIZE;
+		if (iBYMax <= 0)
+			continue;
+
+		const dword dwBlockIdx = (dword)(((pt.m_x / UO_BLOCK_SIZE) * iBYMax) + (pt.m_y / UO_BLOCK_SIZE));
+
+		if (tile.fOverlay)
+		{
+			// Serpme katmanı: zemine hiç dokunmadan eski serpintiyi geri koy.
+			if (!SetOverlayTile(pt, tile.wId))
+				continue;
+
+			++iRestored;
+			setDirtyOverlayBlocks.insert(dwBlockIdx);
+			continue;
+		}
+
+		if (!SetTerrainTile(pt, tile.wId, tile.z, false))
+			continue;
+
+		++iRestored;
+		setDirtyBlocks.insert(dwBlockIdx);
+	}
+
+	for (const dword dwBlockIdx : setDirtyBlocks)
+		SendTerrainBlockUpdateAt(iUndoMap, dwBlockIdx);
+
+	for (const dword dwBlockIdx : setDirtyOverlayBlocks)
+		SendOverlayBlockUpdate(iUndoMap, dwBlockIdx);
+
+	return iRestored;
+}
+
+
+int CWorldMap::GetTerrainUndoDepth() noexcept // static
+{
+	return (int)s_TerrainUndo.size();
+}
