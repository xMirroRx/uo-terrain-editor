+	// MyShard: sub-command 0xCD = one terrain editor brush stroke.
+	//  byte tool, word x, word y, word tile id, byte radius, byte flags (bit 0 = square brush), sbyte z,
+	//  byte edge softness in percent (all little-endian).
+	if ((byte)type == 0xCD)
+	{
+		CChar* pChar = client->GetChar();
+		if ((pChar == nullptr) || (packetLength < 15))
+			return true;
+
+		if (client->GetPrivLevel() < PLEVEL_GM)
+		{
+			client->SysMessage("You are not allowed to edit the terrain.");
+			return true;
+		}
+
+		// Live terrain updates have to be on, otherwise the editor would paint into the void.
+		client->addUltimaLive();
+
+		const byte bTool = readByte();
+		const uint uiX = readByte() | ((uint)readByte() << 8);
+		const uint uiY = readByte() | ((uint)readByte() << 8);
+		const uint uiTileId = readByte() | ((uint)readByte() << 8);
+		const int iRadius = (int)readByte();
+		const byte bFlags = readByte();
+		const int iZValue = (int)(int8)readByte();
+		const int iSoftness = (int)readByte();
+		const int iSetSize = (packetLength >= 16) ? (int)readByte() : 1;	// texture set: NxN tiles per picture
+		const int iShape = (packetLength >= 17) ? (int)readByte() : 0;	// brush shape
+
+		// The weaker mixes of the same texture, used to fade the edge of a stroke (0 = none).
+		word wVariantMid = 0, wVariantLow = 0;
+		int iVariantMidSet = 1, iVariantLowSet = 1;
+
+		if (packetLength >= 23)
+		{
+			wVariantMid = (word)(readByte() | ((uint)readByte() << 8));
+			iVariantMidSet = (int)readByte();
+			wVariantLow = (word)(readByte() | ((uint)readByte() << 8));
+			iVariantLowSet = (int)readByte();
+		}
+
+		const CPointMap pt((short)uiX, (short)uiY, 0, (uchar)(pChar->GetTopPoint().m_map));
+		if (!pt.IsValidPoint())
+			return true;
+
+		// Serpme katmanı (kum, çakıl, taş kırıntısı) zemine hiç dokunmaz: zeminin üstüne ayrı bir
+		// katman olarak serpilir, altındaki döşeme olduğu gibi kalır. z alanı yoğunluğu, setSize
+		// çeşitleme sayısını, wVariantMid de fırçanın bu vuruştaki tohumunu taşır.
+		if ((bTool == TERRAIN_TOOL_OVERLAY) || (bTool == TERRAIN_TOOL_OVERLAY_DEL))
+		{
+			const int iDensity = maximum(1, minimum(100, (int)(byte)iZValue));
+
+			if (CWorldMap::EditOverlayArea(pt, (word)uiTileId, iSetSize, iRadius, (bFlags & 0x01) != 0,
+				iDensity, iShape, wVariantMid, bTool == TERRAIN_TOOL_OVERLAY_DEL) <= 0)
+			{
+				client->SysMessage((bTool == TERRAIN_TOOL_OVERLAY_DEL) ? "Serpme: orada silinecek bir şey yok." : "Serpme: orası zaten dolu.");
+			}
+
+			return true;
+		}
+
+		if (CWorldMap::EditTerrainArea(pt, (int)bTool, (word)uiTileId, iZValue, iRadius, (bFlags & 0x01) != 0, iSoftness, iSetSize, iShape, wVariantMid, iVariantMidSet, wVariantLow, iVariantLowSet) <= 0)
+			client->SysMessage("Terrain: nothing to change there.");
+
+		return true;
+	}
+
+	// MyShard: sub-command 0xCB = the decoration brush: word x, word y, word item id, byte radius,
+	//  byte flags (bit 0 = square, bit 1 = erase), byte density, byte shape (all little-endian).
+	if ((byte)type == 0xCB)
+	{
+		CChar* pChar = client->GetChar();
+		if ((pChar == nullptr) || (packetLength < 14))
+			return true;
+
+		if (client->GetPrivLevel() < PLEVEL_GM)
+		{
+			client->SysMessage("You are not allowed to edit the terrain.");
+			return true;
+		}
+
+		const uint uiX = readByte() | ((uint)readByte() << 8);
+		const uint uiY = readByte() | ((uint)readByte() << 8);
+		const uint uiItemId = readByte() | ((uint)readByte() << 8);
+		const int iRadius = (int)readByte();
+		const byte bFlags = readByte();
+		const int iDensity = (int)readByte();
+		const int iShape = (int)readByte();
+
+		const CPointMap pt((short)uiX, (short)uiY, 0, (uchar)(pChar->GetTopPoint().m_map));
+		if (!pt.IsValidPoint())
+			return true;
+
+		const bool fErase = (bFlags & 0x02) != 0;
+		const int iDone = CWorldMap::EditStaticArea(pt, pChar, uiItemId, iRadius, (bFlags & 0x01) != 0, iDensity, iShape, fErase);
+
+		if (iDone <= 0)
+			client->SysMessage(fErase ? "Decoration: nothing of ours there." : "Decoration: nothing placed.");
+
+		return true;
+	}
+
+	// MyShard: sub-command 0xCC = terrain editor command without a brush: byte action (0 = undo, 1 = save).
+	if ((byte)type == 0xCC)
+	{
+		if ((client->GetChar() == nullptr) || (packetLength < 5))
+			return true;
+
+		if (client->GetPrivLevel() < PLEVEL_GM)
+		{
+			client->SysMessage("You are not allowed to edit the terrain.");
+			return true;
+		}
+
+		const byte bAction = readByte();
+
+		switch (bAction)
+		{
+			case 0:
+			{
+				const int iRestored = CWorldMap::UndoTerrainStroke();
+				if (iRestored > 0)
+					client->SysMessagef("Terrain: undone (%d tiles, %d strokes left).", iRestored, CWorldMap::GetTerrainUndoDepth());
+				else
+					client->SysMessage("Terrain: nothing left to undo.");
+				break;
+			}
+
+			case 1:
+				if (CWorldMap::SaveTerrainEdits())
+					client->SysMessage("Terrain: saved.");
+				else
+					client->SysMessage("Terrain: saving failed, see the console.");
+				break;
+
+			default:
+				break;
+		}
+
+		return true;
+	}
