+// ----- serpme katmanı -----
+// Kum, çakıl, taş kırıntısı gibi şeyler zeminin yerine geçmez: ayrı bir katmanda durur ve istemci
+// onları zeminin üstüne çizer. Böylece döşediğin taşın üstüne kum serpince taş kaybolmaz.
+
+bool CWorldMap::SetOverlayTile(const CPointMap& pt, word wTileId) // static
+{
+	ADDTOCALLSTACK("CWorldMap::SetOverlayTile");
+	if (!pt.IsValidPoint())
+		return false;
+
+	const int iMap = pt.m_map;
+	const int iBYMax = g_MapList.GetMapSizeY(iMap) / UO_BLOCK_SIZE;
+	if (iBYMax <= 0)
+		return false;
+
+	const dword dwBlockIdx = (dword)(((pt.m_x / UO_BLOCK_SIZE) * iBYMax) + (pt.m_y / UO_BLOCK_SIZE));
+	const int iIdx = (UO_BLOCK_OFFSET(pt.m_y) * UO_BLOCK_SIZE) + UO_BLOCK_OFFSET(pt.m_x);
+
+	g_MapEdits.SetOverlay(iMap, dwBlockIdx, iIdx, wTileId);
+	return true;
+}
+
+void CWorldMap::SendOverlayBlockUpdate(int iMap, dword dwBlockIdx) // static
+{
+	ADDTOCALLSTACK("CWorldMap::SendOverlayBlockUpdate");
+	// Serpme katmanı harita dosyalarına dokunmuyor, o yüzden canlı zemin (UltimaLive) kipi gerekmez:
+	// yakındaki herkese gidebilir.
+	const CMapOverlayBlock* pBlock = g_MapEdits.GetOverlayBlock(iMap, dwBlockIdx);
+	if (pBlock == nullptr)
+		return;
+
+	ClientIterator it;
+	for (CClient* pClient = it.next(); pClient != nullptr; pClient = it.next())
+	{
+		const CChar* pChar = pClient->GetChar();
+		if (!TerrainBlockNearChar(pChar, iMap, dwBlockIdx, TERRAIN_SEND_RANGE_BLOCKS))
+			continue;
+
+		new PacketUpdateTerrainOverlay(pClient, dwBlockIdx, pBlock, (byte)iMap);
+		pClient->m_setOverlaySentBlocks.emplace(dwBlockIdx);
+	}
+}
+
+int CWorldMap::EditOverlayArea(const CPointMap& ptCenter, word wTileId, int iVariants, int iRadius, bool fSquare,
+	int iDensity, int iShape, word wSeed, bool fErase) // static
+{
+	ADDTOCALLSTACK("CWorldMap::EditOverlayArea");
+	// Serpme fırçası. Her kare serpintinin rastgele bir çeşitlemesini alır, yoğunluk da karelerin ne
+	// kadarının dolacağını söyler: aynı yerde fırçayı gezdirdikçe alan tek parça bir kütleye dönüşmez,
+	// gerçekten serpilmiş gibi dolar.
+	if (!ptCenter.IsValidPoint())
+		return 0;
+
+	iRadius = maximum(0, minimum(TERRAIN_BRUSH_MAX_RADIUS, iRadius));
+	iDensity = maximum(1, minimum(100, iDensity));
+	iVariants = maximum(1, minimum(64, iVariants));
+	iShape = ((iShape >= 0) && (iShape < TERRAIN_SHAPE_QTY)) ? iShape : TERRAIN_SHAPE_ROUND;
+
+	const int iMap = ptCenter.m_map;
+	const int iBYMax = g_MapList.GetMapSizeY(iMap) / UO_BLOCK_SIZE;
+	if (iBYMax <= 0)
+		return 0;
+
+	const float fRadius = (float)iRadius + 0.5f;
+	const float fCore = fRadius;	// kenarı yoğunluk kırıyor, ayrıca eritmeye gerek yok
+
+	std::set<dword> setDirtyBlocks;
+	std::vector<TerrainEditTile> vecUndo;
+	int iChanged = 0;
+
+	for (int dy = -iRadius; dy <= iRadius; ++dy)
+	{
+		for (int dx = -iRadius; dx <= iRadius; ++dx)
+		{
+			const float fWeight = TerrainBrushWeight(iShape, (float)dx, (float)dy, fRadius, fCore, fSquare,
+				ptCenter.m_x + dx, ptCenter.m_y + dy);
+
+			if (fWeight <= 0.0f)
+				continue;
+
+			const CPointMap pt((short)(ptCenter.m_x + dx), (short)(ptCenter.m_y + dy), 0, (uchar)iMap);
+			if (!pt.IsValidPoint())
+				continue;
+
+			const dword dwBlockIdx = (dword)(((pt.m_x / UO_BLOCK_SIZE) * iBYMax) + (pt.m_y / UO_BLOCK_SIZE));
+			const int iIdx = (UO_BLOCK_OFFSET(pt.m_y) * UO_BLOCK_SIZE) + UO_BLOCK_OFFSET(pt.m_x);
+			const word wOld = g_MapEdits.GetOverlay(iMap, dwBlockIdx, iIdx);
+			word wNew;
+
+			if (fErase)
+			{
+				wNew = 0;
+			}
+			else
+			{
+				// Hangi karelerin dolacağı her vuruşta değişsin: tohum fırça her bastığında başka.
+				const float fChance = ((float)iDensity / 100.0f) * minimum(1.0f, fWeight);
+				if (TerrainEditNoise((pt.m_x * 5) + (int)wSeed, (pt.m_y * 11) + (int)wSeed) > fChance)
+					continue;
+
+				// Aynı serpintiden zaten varsa dokunma: fırçayı basılı tutarken aynı kareler boşuna
+				// yeniden kurulmasın, alan yavaşça dolsun.
+				if ((wOld >= wTileId) && (wOld < (word)(wTileId + iVariants)))
+					continue;
+
+				const int iPick = (int)(TerrainEditNoise((pt.m_x * 17) + ((int)wSeed * 3), (pt.m_y * 23) + ((int)wSeed * 7)) * (float)iVariants);
+				wNew = (word)(wTileId + minimum(iVariants - 1, maximum(0, iPick)));
+			}
+
+			if (wNew == wOld)
+				continue;
+
+			if (!SetOverlayTile(pt, wNew))
+				continue;
+
+			vecUndo.emplace_back(TerrainEditTile{ iMap, pt.m_x, pt.m_y, wOld, (int8)0, true });
+			++iChanged;
+			setDirtyBlocks.insert(dwBlockIdx);
+		}
+	}
+
+	for (const dword dwBlockIdx : setDirtyBlocks)
+		SendOverlayBlockUpdate(iMap, dwBlockIdx);
+
+	if (!vecUndo.empty())
+	{
+		s_TerrainUndo.emplace_back(std::move(vecUndo));
+		while (s_TerrainUndo.size() > TERRAIN_UNDO_MAX_STROKES)
+			s_TerrainUndo.erase(s_TerrainUndo.begin());
+	}
+
+	if ((iChanged > 0) && g_MapEdits.IsDirty())
+	{
+		const int64 iNow = CWorldGameTime::GetCurrentTime().GetTimeRaw();
+
+		if (iNow >= s_iTerrainNextSave)
+		{
+			s_iTerrainNextSave = iNow + (30 * MSECS_PER_SEC);
+			SaveTerrainEdits();
+		}
+	}
+
+	return iChanged;
+}
+
+// ----- Texture sets -----
+// A texture set is one picture cut into N x N land tiles (see the terrain texture importer). The editor
+// tells us the set size when it paints, but the smoothing tool also has to know which tiles belong
+// together, so the list written next to the mul files is read once here.
+struct TerrainTileSet
+{
+	word wBase;
+	int iSize;
+};
+
+static std::unordered_map<word, TerrainTileSet> s_TerrainSets;	// every piece points at its set
+static bool s_fTerrainSetsLoaded = false;
+
+static void LoadTerrainSets()
+{
+	if (s_fTerrainSetsLoaded)
+		return;
+
+	s_fTerrainSetsLoaded = true;
+
+	const CSString sPath = g_Install.GetPreferPath("myshard_terrain_sets.txt");
+	CSFileText file;
+	if (!file.Open(sPath.GetBuffer(), OF_READ | OF_TEXT | OF_NONCRIT))
+		return;
+
+	tchar szLine[256];
+	int iSets = 0;
+
+	while (file.ReadString(szLine, sizeof(szLine) - 1) != nullptr)
+	{
+		// "0x1000 16 black irregular cobblestone"
+		uint uiBase = 0;
+		int iSize = 0;
+		if (sscanf(szLine, "%x %d", &uiBase, &iSize) != 2)
+			continue;
+		if ((iSize < 1) || (iSize > 16) || (uiBase == 0) || (uiBase > 0x3FFF))
+			continue;
+
+		const TerrainTileSet set{ (word)uiBase, iSize };
+		for (int i = 0; i < (iSize * iSize); ++i)
+		{
+			const uint uiPiece = uiBase + (uint)i;
+			if (uiPiece <= 0x3FFF)
+				s_TerrainSets[(word)uiPiece] = set;
+		}
+		++iSets;
+	}
+
+	file.Close();
+
+	if (iSets > 0)
+		g_Log.Event(LOGM_INIT, "Loaded %d terrain texture set(s) from '%s'.\n", iSets, sPath.GetBuffer());
+}
+
+// The ground a tile belongs to: the set it is a piece of, or the tile itself.
+static word TerrainGroundOf(word wGraphic)
+{
+	LoadTerrainSets();
+
+	const auto it = s_TerrainSets.find(wGraphic);
+	return (it == s_TerrainSets.end()) ? wGraphic : it->second.wBase;
+}
+
+// The tile of wGraphic.s ground that belongs at these coordinates. For a plain tile that is the tile
+// itself; for a piece of a texture set it is the piece whose place this is, so smoothing never breaks
+// the picture apart.
+static word TerrainPieceAt(word wGraphic, int iX, int iY)
+{
+	LoadTerrainSets();
+
+	const auto it = s_TerrainSets.find(wGraphic);
+	if (it == s_TerrainSets.end())
+		return wGraphic;
+
+	const int iSize = it->second.iSize;
+	const int iPx = ((iX % iSize) + iSize) % iSize;
+	const int iPy = ((iY % iSize) + iSize) % iSize;
+
+	return (word)(it->second.wBase + (iPx * iSize) + iPy);
+}
+
+
+// Brush shapes. The client draws its icons from the same formulas, so what you see in the grid is what
+// the brush does. dx/dy are tile offsets from the brush centre.
+float CWorldMap::TerrainBrushWeight(int iShape, float fdx, float fdy, float fRadius, float fCore, bool fSquare, int iWorldX, int iWorldY) noexcept // static
+{
+	if (fRadius <= 0.0f)
+		return ((fdx == 0.0f) && (fdy == 0.0f)) ? 1.0f : 0.0f;
+
+	// The plain distance of this tile from the centre, in the metric of the shape.
+	float fDist;
+
+	switch (iShape)
+	{
+		default:
+		case TERRAIN_SHAPE_ROUND:
+		case TERRAIN_SHAPE_HARD:
+		case TERRAIN_SHAPE_SPECKLE:
+		case TERRAIN_SHAPE_ORGANIC:
+			fDist = fSquare ? maximum(fabsf(fdx), fabsf(fdy)) : sqrtf((fdx * fdx) + (fdy * fdy));
+			break;
+
+		case TERRAIN_SHAPE_SQUARE:
+			fDist = maximum(fabsf(fdx), fabsf(fdy));
+			break;
+
+		case TERRAIN_SHAPE_LINE_NS:		// a narrow line along the north-south axis
+			fDist = sqrtf((fdx * fdx * 16.0f) + (fdy * fdy));
+			break;
+
+		case TERRAIN_SHAPE_LINE_WE:
+			fDist = sqrtf((fdx * fdx) + (fdy * fdy * 16.0f));
+			break;
+
+		case TERRAIN_SHAPE_LINE_NE:		// narrow along one diagonal
+		{
+			const float fu = (fdx + fdy) * 0.70710678f;
+			const float fv = (fdx - fdy) * 0.70710678f;
+			fDist = sqrtf((fv * fv * 16.0f) + (fu * fu));
+			break;
+		}
+
+		case TERRAIN_SHAPE_LINE_NW:
+		{
+			const float fu = (fdx - fdy) * 0.70710678f;
+			const float fv = (fdx + fdy) * 0.70710678f;
+			fDist = sqrtf((fv * fv * 16.0f) + (fu * fu));
+			break;
+		}
+
+		case TERRAIN_SHAPE_RING:
+		{
+			// Hollow: strongest at 70% of the radius, nothing in the middle.
+			const float fBase = sqrtf((fdx * fdx) + (fdy * fdy));
+			const float fBand = maximum(1.0f, fRadius * 0.3f);
+			const float fOff = fabsf(fBase - (fRadius * 0.7f));
+			return (fOff >= fBand) ? 0.0f : (1.0f - (fOff / fBand));
+		}
+
+		case TERRAIN_SHAPE_STAR4:
+		{
+			// Four arms: the diagonals are pushed away, the axes stay.
+			const float fBase = sqrtf((fdx * fdx) + (fdy * fdy));
+			const float fSmall = minimum(fabsf(fdx), fabsf(fdy));
+			fDist = fBase + (fSmall * 2.0f);
+			break;
+		}
+
+		case TERRAIN_SHAPE_STAR8:
+		{
+			const float fBase = sqrtf((fdx * fdx) + (fdy * fdy));
+			const float fSmallAxis = minimum(fabsf(fdx), fabsf(fdy));
+			const float fu = fabsf((fdx + fdy) * 0.70710678f);
+			const float fv = fabsf((fdx - fdy) * 0.70710678f);
+			const float fSmallDiag = minimum(fu, fv);
+			fDist = fBase + (minimum(fSmallAxis, fSmallDiag) * 2.5f);
+			break;
+		}
+
+		case TERRAIN_SHAPE_DOT:
+			fDist = sqrtf((fdx * fdx) + (fdy * fdy)) * 2.5f;	// a small core inside the same radius
+			break;
+	}
+
+	if (fDist > fRadius)
+		return 0.0f;
+
+	float fWeight;
+
+	if (iShape == TERRAIN_SHAPE_HARD || iShape == TERRAIN_SHAPE_SQUARE)
+		fWeight = 1.0f;	// no fade at all, a stamp with a clean edge
+	else
+		fWeight = (fDist <= fCore) ? 1.0f : ((fRadius > fCore) ? ((fRadius - fDist) / (fRadius - fCore)) : 0.0f);
+
+	if (iShape == TERRAIN_SHAPE_SPECKLE)
+	{
+		// Scattered dots: most tiles are skipped, the rest apply fully.
+		fWeight *= (TerrainEditNoise(iWorldX * 3, iWorldY * 3) > 0.55f) ? 1.0f : 0.0f;
+	}
+	else if (iShape == TERRAIN_SHAPE_ORGANIC)
+	{
+		// Uneven, blotchy edge: good for natural ground.
+		fWeight *= 0.35f + (0.65f * TerrainEditNoise(iWorldX, iWorldY));
+	}
+
+	return fWeight;
+}
+int CWorldMap::EditTerrainArea(const CPointMap& ptCenter, int iTool, word wTerrainId, int iZValue, int iRadius, bool fSquare, int iSoftness, int iSetSize, int iShape, word wVariantMid, int iVariantMidSet, word wVariantLow, int iVariantLowSet) // static
+{
+	ADDTOCALLSTACK("CWorldMap::EditTerrainArea");
+	// One brush stroke of the terrain editor. Every touched block is pushed to the clients once,
+	// at the end, instead of once per tile.
+	// iSoftness (0..100) is the share of the brush radius that fades out: the height tools apply a
+	// smaller and smaller part of their change towards the edge, and paint scatters its tiles there,
+	// so a stroke blends into the terrain around it instead of stamping a hard circle.
+	if (!ptCenter.IsValidPoint())
+		return 0;
+
+	iRadius = maximum(0, minimum(TERRAIN_BRUSH_MAX_RADIUS, iRadius));
+	iSoftness = maximum(0, minimum(100, iSoftness));
+	iSetSize = maximum(1, minimum(16, iSetSize));
+	iShape = ((iShape >= 0) && (iShape < TERRAIN_SHAPE_QTY)) ? iShape : TERRAIN_SHAPE_ROUND;
+	// Zayıf karışım varyantları artık kullanılmıyor (boyama sade haline döndü), ama paket uyumu için duruyor.
+	UnreferencedParameter(wVariantMid);
+	UnreferencedParameter(wVariantLow);
+	UnreferencedParameter(iVariantMidSet);
+	UnreferencedParameter(iVariantLowSet);
+	const int iMap = ptCenter.m_map;
+	const int iSide = (iRadius * 2) + 1;
+
+	// Snapshot the heights first (with a one tile border), so that smoothing reads the terrain as it
+	// was before this stroke and doesn't feed on its own output.
+	const int iSnapSide = iSide + 2;
+	std::vector<int8> vecHeights((size_t)(iSnapSide * iSnapSide), (int8)0);
+	std::vector<word> vecIds((size_t)(iSnapSide * iSnapSide), (word)0);
+	std::vector<bool> vecValid((size_t)(iSnapSide * iSnapSide), false);
+	for (int iy = 0; iy < iSnapSide; ++iy)
+	{
+		for (int ix = 0; ix < iSnapSide; ++ix)
+		{
+			const CPointMap pt((short)(ptCenter.m_x - iRadius - 1 + ix), (short)(ptCenter.m_y - iRadius - 1 + iy), 0, (uchar)iMap);
+			if (!pt.IsValidPoint())
+				continue;
+			const CUOMapMeter* pMeter = GetMapMeter(pt);
+			if (pMeter == nullptr)
+				continue;
+			vecHeights[(size_t)((iy * iSnapSide) + ix)] = pMeter->m_z;
+			vecIds[(size_t)((iy * iSnapSide) + ix)] = pMeter->m_wTerrainIndex;
+			vecValid[(size_t)((iy * iSnapSide) + ix)] = true;
+		}
+	}
+
+	std::set<dword> setDirtyBlocks;
+	std::vector<TerrainEditTile> vecUndo;	// what this stroke replaced, for UNDO
+	int iChanged = 0;
+	int iRevertFailed = 0;					// tiles RESET could not restore (no original data)
+	const float fRadius = (float)iRadius + 0.5f;
+
+	// The soft edge is a band at the rim, not a share of the whole brush: a wide brush should still lay
+	// a solid floor and only fade over the last few tiles. Without this a 33x33 brush at 70% turned into
+	// a twelve tile wide field of scattered single tiles instead of a paved area with a soft border.
+	const float fFadeBand = ((float)iSoftness / 100.0f) * minimum(fRadius * 0.5f, 6.0f);
+	const float fCore = maximum(0.0f, fRadius - fFadeBand);	// full strength up to here
+
+	for (int dy = -iRadius; dy <= iRadius; ++dy)
+	{
+		for (int dx = -iRadius; dx <= iRadius; ++dx)
+		{
+			// How much of the brush applies here: 1 in the core, fading to 0 at the edge, in the shape
+			// the user picked.
+			float fWeight = TerrainBrushWeight(iShape, (float)dx, (float)dy, fRadius, fCore, fSquare,
+				ptCenter.m_x + dx, ptCenter.m_y + dy);
+
+			if (fWeight <= 0.0f)
+				continue;
+			fWeight = minimum(1.0f, fWeight);
+
+			const CPointMap pt((short)(ptCenter.m_x + dx), (short)(ptCenter.m_y + dy), 0, (uchar)iMap);
+			if (!pt.IsValidPoint())
+				continue;
+
+			const CUOMapMeter* pMeter = GetMapMeter(pt);
+			if (pMeter == nullptr)
+				continue;
+
+			word wNewId = pMeter->m_wTerrainIndex;
+			int iNewZ = pMeter->m_z;
+
+			switch (iTool)
+			{
+				case TERRAIN_TOOL_PAINT:
+				case TERRAIN_TOOL_PAINTZ:
+				{
+					// A tile is either the new ground or not. The soft edge thins the tiles out towards the
+					// rim, so the border breaks up instead of ending in a clean circle.
+					if ((fWeight < 1.0f) && (TerrainEditNoise(pt.m_x, pt.m_y) > fWeight))
+						continue;
+
+					// A texture set is one picture cut into N x N tiles: pick the piece that belongs at
+					// these world coordinates, so the pieces line up into the whole picture.
+					if (iSetSize > 1)
+						wNewId = (word)(wTerrainId + (((pt.m_x % iSetSize) * iSetSize) + (pt.m_y % iSetSize)));
+					else
+						wNewId = wTerrainId;
+
+					if (iTool == TERRAIN_TOOL_PAINTZ)
+						iNewZ = pMeter->m_z + (int)lroundf((float)(iZValue - pMeter->m_z) * fWeight);
+
+					break;
+				}
+
+				case TERRAIN_TOOL_SETZ:
+					iNewZ = pMeter->m_z + (int)lroundf((float)(iZValue - pMeter->m_z) * fWeight);
+					break;
+
+				case TERRAIN_TOOL_RAISE:
+					iNewZ = pMeter->m_z + (int)lroundf((float)iZValue * fWeight);
+					break;
+
+				case TERRAIN_TOOL_SMOOTH:
+				{
+					// Weighted average of the 3x3 neighbourhood, taken from the snapshot so the stroke
+					// does not feed on its own output. iZValue carries the strength in percent.
+					const int ix = dx + iRadius + 1;
+					const int iy = dy + iRadius + 1;
+					float fSum = 0.0f, fQty = 0.0f;
+					for (int ny = -1; ny <= 1; ++ny)
+					{
+						for (int nx = -1; nx <= 1; ++nx)
+						{
+							const size_t uiIdx = (size_t)(((iy + ny) * iSnapSide) + (ix + nx));
+							if (!vecValid[uiIdx])
+								continue;
+							const float fKernel = ((nx == 0) && (ny == 0)) ? 1.0f : (((nx == 0) || (ny == 0)) ? 2.0f : 1.0f);
+							fSum += (float)vecHeights[uiIdx] * fKernel;
+							fQty += fKernel;
+						}
+					}
+					if (fQty <= 0.0f)
+						continue;
+
+					const float fAverage = fSum / fQty;
+					const float fStrength = (iZValue > 0) ? (minimum(100, iZValue) / 100.0f) : 1.0f;
+					const float fDelta = (fAverage - (float)pMeter->m_z) * fWeight * fStrength;
+
+					// Rounding would eat every change below half a step and the tool would look dead on
+					// gentle slopes, so always move at least one step towards the average.
+					int iStep = (int)lroundf(fDelta);
+					if ((iStep == 0) && (fabsf(fAverage - (float)pMeter->m_z) >= 0.5f) && (fWeight >= 0.5f))
+						iStep = (fDelta > 0.0f) ? 1 : ((fDelta < 0.0f) ? -1 : 0);
+
+					iNewZ = pMeter->m_z + iStep;
+
+					// Also round off the painted shape itself: a tile that is surrounded by another
+					// graphic takes that graphic. This eats the jagged staircase edges and the single
+					// stray tiles a brush leaves behind, which is what smoothing means on flat ground.
+					// The strength decides how convincing the neighbourhood has to be.
+					const int iNeeded = maximum(4, minimum(8, 5 + (int)lroundf((100.0f - (fStrength * 100.0f)) / 33.0f)));
+					word wBest = 0;
+					int iBestQty = 0;
+					for (int ny = -1; ny <= 1; ++ny)
+					{
+						for (int nx = -1; nx <= 1; ++nx)
+						{
+							if ((nx == 0) && (ny == 0))
+								continue;
+							const size_t uiIdx = (size_t)(((iy + ny) * iSnapSide) + (ix + nx));
+							if (!vecValid[uiIdx])
+								continue;
+
+							// Count by ground, not by tile: the pieces of one texture set are different
+							// tiles but the same ground, and so are the variants of UO's own grounds.
+							const word wCandidate = vecIds[uiIdx];
+							const word wCandidateGround = TerrainGroundOf(wCandidate);
+							int iCandidateQty = 0;
+							for (int my = -1; my <= 1; ++my)
+							{
+								for (int mx = -1; mx <= 1; ++mx)
+								{
+									if ((mx == 0) && (my == 0))
+										continue;
+									const size_t uiOther = (size_t)(((iy + my) * iSnapSide) + (ix + mx));
+									if (vecValid[uiOther] && (TerrainGroundOf(vecIds[uiOther]) == wCandidateGround))
+										++iCandidateQty;
+								}
+							}
+
+							if (iCandidateQty > iBestQty)
+							{
+								iBestQty = iCandidateQty;
+								wBest = wCandidate;
+							}
+						}
+					}
+
+					// Take over the neighbourhood's ground, but as the piece that belongs at these
+					// coordinates: copying the neighbour's own piece would scramble a texture set.
+					if ((iBestQty >= iNeeded) && (fWeight >= 0.35f))
+					{
+						const word wPiece = TerrainPieceAt(wBest, pt.m_x, pt.m_y);
+
+						if (wPiece != pMeter->m_wTerrainIndex)
+							wNewId = wPiece;
+					}
+
+					break;
+				}
+
+				case TERRAIN_TOOL_REVERT:
+				{
+					// Put the untouched map data back. The mul file is the real original, so it is read
+					// first; the copy taken at the first edit is only a fallback for when that read fails.
+					const int iBx = pt.m_x / UO_BLOCK_SIZE;
+					const int iBy = pt.m_y / UO_BLOCK_SIZE;
+					const dword dwOrigIdx = (dword)((iBx * (g_MapList.GetMapSizeY(iMap) / UO_BLOCK_SIZE)) + iBy);
+
+					CUOMapBlock blockFromMul{};
+					const CUOMapBlock* pOriginal = nullptr;
+
+					if (ReadTerrainBlockFromMul(iMap, dwOrigIdx, blockFromMul))
+						pOriginal = &blockFromMul;
+					else
+						pOriginal = g_MapEdits.GetOriginalBlock(iMap, dwOrigIdx);
+
+					if (pOriginal == nullptr)
+					{
+						++iRevertFailed;
+						continue;
+					}
+
+					const CUOMapMeter& meterOrig = pOriginal->m_Meter[(UO_BLOCK_OFFSET(pt.m_y) * UO_BLOCK_SIZE) + UO_BLOCK_OFFSET(pt.m_x)];
+					wNewId = meterOrig.m_wTerrainIndex;
+					iNewZ = meterOrig.m_z;
+					break;
+				}
+
+				default:
+					return 0;
+			}
+
+			iNewZ = maximum(-128, minimum(127, iNewZ));
+			if ((wNewId == pMeter->m_wTerrainIndex) && (iNewZ == pMeter->m_z))
+				continue;
+
+			const TerrainEditTile tileOld{ iMap, pt.m_x, pt.m_y, pMeter->m_wTerrainIndex, pMeter->m_z, false };
+
+			if (!SetTerrainTile(pt, wNewId, (int8)iNewZ, false))
+				continue;
+
+			vecUndo.emplace_back(tileOld);
+			++iChanged;
+			const int iBx = pt.m_x / UO_BLOCK_SIZE;
+			const int iBy = pt.m_y / UO_BLOCK_SIZE;
+			setDirtyBlocks.insert((dword)((iBx * (g_MapList.GetMapSizeY(iMap) / UO_BLOCK_SIZE)) + iBy));
+		}
+	}
+
+	for (const dword dwBlockIdx : setDirtyBlocks)
+		SendTerrainBlockUpdateAt(iMap, dwBlockIdx);
+
+	if (!vecUndo.empty())
+	{
+		s_TerrainUndo.emplace_back(std::move(vecUndo));
+		while (s_TerrainUndo.size() > TERRAIN_UNDO_MAX_STROKES)
+			s_TerrainUndo.erase(s_TerrainUndo.begin());
+	}
+
+	// Write the edits out every now and then. The world save would do it too, but a terrain session is
+	// usually a long series of strokes and nobody wants to lose an afternoon of building to a crash.
+	if ((iChanged > 0) && g_MapEdits.IsDirty())
+	{
+		const int64 iNow = CWorldGameTime::GetCurrentTime().GetTimeRaw();
+
+		if (iNow >= s_iTerrainNextSave)
+		{
+			s_iTerrainNextSave = iNow + (30 * MSECS_PER_SEC);
+			SaveTerrainEdits();
+		}
+	}
+
+	if (iRevertFailed > 0)
+		g_Log.EventWarn("Terrain RESET: %d tile(s) had no original map data.\n", iRevertFailed);
+
+
+	return iChanged;
+}
