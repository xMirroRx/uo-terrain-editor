+/***************************************************************************
+ *
+ *
+ *	Packet 0x40 : PacketUpdateTerrain		UltimaLive terrain block update (NORMAL)
+ *
+ *
+ ***************************************************************************/
+PacketUpdateTerrain::PacketUpdateTerrain(const CClient* target, dword dwBlockIdx, const CUOMapBlock* pBlock, byte bMap) : PacketSend(XCMD_UpdateTerrain, 201, PRI_NORMAL)
+{
+	ADDTOCALLSTACK("PacketUpdateTerrain::PacketUpdateTerrain");
+	// Fixed size packet: 0x40 + block index (4) + terrain data (192) + padding (3) + map (1) = 201 bytes.
+	ASSERT(pBlock != nullptr);
+
+	writeInt32(dwBlockIdx);
+	writeData(reinterpret_cast<const byte*>(pBlock->m_Meter), sizeof(pBlock->m_Meter));	// 8x8 meters, 192 bytes
+	writeByte(0);
+	writeByte(0);
+	writeByte(0);
+	writeByte(bMap);
+
+	push(target);
+}
+
+/***************************************************************************
+ *
+ *
+ *	Packet 0x3F alt komut 0xF0 : PacketUpdateTerrainOverlay	serpme katmanı bloğu (NORMAL)
+ *
+ *
+ ***************************************************************************/
+PacketUpdateTerrainOverlay::PacketUpdateTerrainOverlay(const CClient* target, dword dwBlockIdx, const CMapOverlayBlock* pBlock, byte bMap) : PacketSend(XCMD_StaticUpdate, 143, PRI_NORMAL)
+{
+	ADDTOCALLSTACK("PacketUpdateTerrainOverlay::PacketUpdateTerrainOverlay");
+	// Serpme katmanı mul verisi değil: zeminin üstüne çizilen ek grafikler. UltimaLive'ın 0x3F paketine
+	// kendi alt komutumuzla biniyor, böylece istemcinin harita dosyalarına hiç dokunmadan taşınıyor.
+	// 0x3F + uzunluk(2) + blok(4) + 0(4) + 0(2) + 0xF0 + harita(1) + 64 word = 143 bayt.
+	ASSERT(pBlock != nullptr);
+
+	initLength();
+	writeInt32(dwBlockIdx);
+	writeInt32(0);
+	writeInt16(0);
+	writeByte(0xF0);
+	writeByte(bMap);
+
+	for (int i = 0; i < (UO_BLOCK_SIZE * UO_BLOCK_SIZE); ++i)
+		writeInt16(pBlock->m_wTile[i]);
+
+	push(target);
+}
