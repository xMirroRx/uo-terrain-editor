+void CClient::addUltimaLive()
+{
+	ADDTOCALLSTACK("CClient::addUltimaLive");
+	// Switch this client to UltimaLive mode: it starts using its own copies of the map files and
+	// accepts live terrain updates. This is NOT done at login on purpose: the first handshake makes
+	// the client copy the map files (hundreds of MB), so we only do it when the terrain editor is used.
+	if ( m_fUltimaLive )
+		return;
+
+	new PacketQueryClient(this, 0x02);	// live login confirmation (shard name = client side folder)
+	new PacketQueryClient(this, 0x01);	// map definitions
+	m_fUltimaLive = true;
+
+	// The client keeps its own copy of the map files between sessions and has no idea what changed while
+	// it was away. The edited blocks around it are fed in from the world tick, a few at a time, so it
+	// catches up without a burst of hundreds of packets.
+	m_setTerrainSentBlocks.clear();
+
+	SysMessage("Live terrain mode enabled: the client is catching up with the edited terrain.");
+}
