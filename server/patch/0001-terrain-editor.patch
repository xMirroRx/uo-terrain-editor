+bool ReadTerrainBlockFromMul(int iMap, dword uiBlockIndex, CUOMapBlock& block)
+{
+	ADDTOCALLSTACK("ReadTerrainBlockFromMul");
+	// Reads a terrain block straight from mapX.mul, ignoring the runtime edits: this is what the
+	// terrain editor restores with RESET, also for blocks edited before we started keeping copies.
+	if (!g_MapList.IsMapSupported(iMap))
+		return false;
+
+	const int iMapNumber = g_MapList.GetMapFileNum(iMap);
+	CSFile* pFile = &(g_Install.m_Maps[iMapNumber]);
+	if ((pFile == nullptr) || !pFile->IsFileOpen())
+		return false;
+
+	CUOIndexRec index;
+	index.SetupIndex(uiBlockIndex * sizeof(CUOMapBlock), sizeof(CUOMapBlock));
+
+	dword fileOffset = index.GetFileOffset();
+	if (g_Install.m_IsMapUopFormat[iMapNumber])
+	{
+		for (int i = 0; i < MAP_SUPPORTED_QTY; ++i)
+		{
+			MapAddress pMapAddress = g_Install.m_UopMapAddress[iMapNumber][i];
+			if ((uiBlockIndex <= pMapAddress.dwLastBlock) && (uiBlockIndex >= pMapAddress.dwFirstBlock))
+			{
+				fileOffset = (dword)(pMapAddress.qwAdress + ((uiBlockIndex - pMapAddress.dwFirstBlock) * 196LL));
+				break;
+			}
+		}
+	}
+
+	if ((uint)pFile->Seek(fileOffset, SEEK_SET) != fileOffset)
+		return false;
+
+	return (pFile->Read(&block, sizeof(CUOMapBlock)) > 0);
+}
