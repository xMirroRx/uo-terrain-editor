+void CWorldMap::InvalidateMapBlock(int iMap, int iBx, int iBy) noexcept // static
+{
+	// Drop a cached map block, so that it gets re-read (and re-patched) on the next access.
+	if ((iMap < 0) || (iMap >= MAP_SUPPORTED_QTY) || !g_MapList.IsInitialized(iMap))
+		return;
+	if (!g_World._Cache._mapBlocks[iMap])
+		return;
+
+	const int iBXMax = g_MapList.GetMapSizeX(iMap) / UO_BLOCK_SIZE;
+	const int iBYMax = g_MapList.GetMapSizeY(iMap) / UO_BLOCK_SIZE;
+	if ((iBx < 0) || (iBx >= iBXMax) || (iBy < 0) || (iBy >= iBYMax))
+		return;
+
+	g_World._Cache._mapBlocks[iMap][(iBy * iBXMax) + iBx].reset();
+}
+
+// How far from a client a changed block still matters. Terrain beyond this is not drawn, and the client
+// picks it up later anyway (see CWorldMap::TickTerrainUpdates).
+#define TERRAIN_SEND_RANGE_BLOCKS	6
+
+static bool TerrainBlockNearChar(const CChar* pChar, int iMap, dword dwBlockIdx, int iRangeBlocks)
+{
+	if ((pChar == nullptr) || (pChar->GetTopMap() != iMap))
+		return false;
+
+	const int iBYMax = g_MapList.GetMapSizeY(iMap) / UO_BLOCK_SIZE;
+	if (iBYMax <= 0)
+		return false;
+
+	const int iBx = (int)(dwBlockIdx / (dword)iBYMax);
+	const int iBy = (int)(dwBlockIdx % (dword)iBYMax);
+	const CPointMap pt = pChar->GetTopPoint();
+
+	return ((abs(iBx - (pt.m_x / UO_BLOCK_SIZE)) <= iRangeBlocks) &&
+			(abs(iBy - (pt.m_y / UO_BLOCK_SIZE)) <= iRangeBlocks));
+}
+
+void CWorldMap::SendTerrainBlockUpdate(int iMap, dword dwBlockIdx, const CUOMapBlock* pBlock) // static
+{
+	ADDTOCALLSTACK("CWorldMap::SendTerrainBlockUpdate");
+	// Push the new terrain block to the clients which can actually see it. A block is 201 bytes, and a
+	// brush stroke touches up to four of them several times a second, so sending them to everyone on the
+	// map would be a lot of traffic for terrain nobody is looking at.
+	if (pBlock == nullptr)
+		return;
+
+	ClientIterator it;
+	for (CClient* pClient = it.next(); pClient != nullptr; pClient = it.next())
+	{
+		if (!pClient->m_fUltimaLive)
+			continue;
+
+		const CChar* pChar = pClient->GetChar();
+		if (!TerrainBlockNearChar(pChar, iMap, dwBlockIdx, TERRAIN_SEND_RANGE_BLOCKS))
+			continue;
+
+		new PacketUpdateTerrain(pClient, dwBlockIdx, pBlock, (byte)iMap);
+		pClient->m_setTerrainSentBlocks.emplace(dwBlockIdx);
+	}
+}
+
+void CWorldMap::TickTerrainUpdates() // static
+{
+	ADDTOCALLSTACK("CWorldMap::TickTerrainUpdates");
+	// Terrain edits live on the server, but every client keeps its own copy of the map files, so a client
+	// only knows about a change once we send it the block. Walking into an area that was built while you
+	// were away has to look right, so each client is slowly fed the edited blocks around it - a few per
+	// tick, never the whole world at once.
+	static constexpr int iMaxPerClient = 4;
+
+	ClientIterator it;
+	for (CClient* pClient = it.next(); pClient != nullptr; pClient = it.next())
+	{
+		const CChar* pChar = pClient->GetChar();
+		if (pChar == nullptr)
+			continue;
+
+		const int iMap = pChar->GetTopMap();
+
+		if (pClient->m_fUltimaLive)
+		{
+			const auto* pBlocks = g_MapEdits.GetBlocks(iMap);
+
+			if ((pBlocks != nullptr) && !pBlocks->empty())
+			{
+				int iSent = 0;
+				for (const auto& entry : *pBlocks)
+				{
+					if (iSent >= iMaxPerClient)
+						break;
+					if (pClient->m_setTerrainSentBlocks.count(entry.first) != 0)
+						continue;
+					if (!TerrainBlockNearChar(pChar, iMap, entry.first, TERRAIN_SEND_RANGE_BLOCKS))
+						continue;
+
+					new PacketUpdateTerrain(pClient, entry.first, &(entry.second), (byte)iMap);
+					pClient->m_setTerrainSentBlocks.emplace(entry.first);
+					++iSent;
+				}
+			}
+		}
+
+		// Serpme katmanı harita dosyalarına dokunmadığı için canlı zemin kipi gerektirmez: herkes alır.
+		const auto* pOverlays = g_MapEdits.GetOverlayBlocks(iMap);
+		if ((pOverlays == nullptr) || pOverlays->empty())
+			continue;
+
+		int iOverlaysSent = 0;
+		for (const auto& entry : *pOverlays)
+		{
+			if (iOverlaysSent >= iMaxPerClient)
+				break;
+			if (pClient->m_setOverlaySentBlocks.count(entry.first) != 0)
+				continue;
+			if (!TerrainBlockNearChar(pChar, iMap, entry.first, TERRAIN_SEND_RANGE_BLOCKS))
+				continue;
+
+			new PacketUpdateTerrainOverlay(pClient, entry.first, &(entry.second), (byte)iMap);
+			pClient->m_setOverlaySentBlocks.emplace(entry.first);
+			++iOverlaysSent;
+		}
+	}
+}
+
+
+bool CWorldMap::SetTerrainTile(const CPointMap& pt, word wTerrainId, int8 z, bool fSendUpdate) // static
+{
+	ADDTOCALLSTACK("CWorldMap::SetTerrainTile");
+	// Change a single terrain tile: store it in the edit layer, drop the cached block and
+	// tell the clients about it.
+	if (!pt.IsValidPoint())
+		return false;
+
+	const int iMap = pt.m_map;
+	const int iBx = pt.m_x / UO_BLOCK_SIZE;
+	const int iBy = pt.m_y / UO_BLOCK_SIZE;
+	const dword dwBlockIdx = (dword)((iBx * (g_MapList.GetMapSizeY(iMap) / UO_BLOCK_SIZE)) + iBy);
+
+	const CServerMapBlock* pMapBlock = GetMapBlock(pt);	// mul (or dif, or a previous edit) data
+	if (pMapBlock == nullptr)
+		return false;
+
+	CUOMapBlock editedBlock = *(pMapBlock->GetTerrainBlock());
+
+	// Keep an untouched copy of the block the first time we touch it: that is what RESET restores.
+	// Only while the block still has no edits, otherwise we would store already edited data as "original".
+	if (g_MapEdits.GetBlock(iMap, dwBlockIdx) == nullptr)
+		g_MapEdits.SetOriginalBlock(iMap, dwBlockIdx, editedBlock);
+
+	CUOMapMeter& meter = editedBlock.m_Meter[(UO_BLOCK_OFFSET(pt.m_y) * UO_BLOCK_SIZE) + UO_BLOCK_OFFSET(pt.m_x)];
+	meter.m_wTerrainIndex = wTerrainId;
+	meter.m_z = z;
+
+	g_MapEdits.SetBlock(iMap, dwBlockIdx, editedBlock);
+	InvalidateMapBlock(iMap, iBx, iBy);
+	if (fSendUpdate)
+		SendTerrainBlockUpdate(iMap, dwBlockIdx, &editedBlock);
+	return true;
+}
+
+void CWorldMap::SendTerrainBlockUpdateAt(int iMap, dword dwBlockIdx) // static
+{
+	// Push one already edited block to the clients.
+	const CUOMapBlock* pBlock = g_MapEdits.GetBlock(iMap, dwBlockIdx);
+	if (pBlock != nullptr)
+		SendTerrainBlockUpdate(iMap, dwBlockIdx, pBlock);
+}
+
