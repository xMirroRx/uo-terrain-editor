+        // The soft disc under the brush, built once: white in the middle, fading to nothing at the rim.
+        private static Texture2D _brushDisc;
+
+        private static Texture2D GetBrushDisc(GraphicsDevice device)
+        {
+            if (_brushDisc != null && !_brushDisc.IsDisposed)
+            {
+                return _brushDisc;
+            }
+
+            const int SIZE = 128;
+            const float R = SIZE / 2f;
+
+            var data = new Color[SIZE * SIZE];
+
+            for (int y = 0; y < SIZE; y++)
+            {
+                for (int x = 0; x < SIZE; x++)
+                {
+                    float dx = (x - R + 0.5f) / R;
+                    float dy = (y - R + 0.5f) / R;
+                    float d = (float)Math.Sqrt((dx * dx) + (dy * dy));
+
+                    if (d >= 1f)
+                    {
+                        continue;
+                    }
+
+                    // Ortada en güçlü, kenara doğru sönen mavimsi-beyaz parıltı (referansla aynı his).
+                    float a = (float)Math.Pow(1f - d, 1.6) * 0.38f;
+
+                    byte alpha = (byte)Math.Clamp(a * 255f, 0, 255);
+                    data[(y * SIZE) + x] = new Color((byte)(200 * a), (byte)(220 * a), (byte)(250 * a), alpha);
+                }
+            }
+
+            _brushDisc = new Texture2D(device, SIZE, SIZE);
+            _brushDisc.SetData(data);
+
+            return _brushDisc;
+        }
+
+        // Outline of a square brush: the four corners of the area, in isometric screen space.
+        private static void DrawTileDiamond(UltimaBatcher2D batcher, World world, GameObject tile, int radius, Color color, float alpha)
+        {
+            int x = tile.X, y = tile.Y;
+            sbyte z = tile.Z;
+
+            Vector2 c1 = TileScreen(world, (ushort)(x - radius), (ushort)(y - radius), z);
+            Vector2 c2 = TileScreen(world, (ushort)(x + radius + 1), (ushort)(y - radius), z);
+            Vector2 c3 = TileScreen(world, (ushort)(x + radius + 1), (ushort)(y + radius + 1), z);
+            Vector2 c4 = TileScreen(world, (ushort)(x - radius), (ushort)(y + radius + 1), z);
+
+            DrawSolidLine(batcher, c1, c2, 3f, color, alpha);
+            DrawSolidLine(batcher, c2, c3, 3f, color, alpha);
+            DrawSolidLine(batcher, c3, c4, 3f, color, alpha);
+            DrawSolidLine(batcher, c4, c1, 3f, color, alpha);
+        }
