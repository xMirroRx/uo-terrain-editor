+        // ----- MyShard terrain editor: the brush outline on the ground, so the size and the soft edge of
+        // the brush are visible before painting. Drawn at the tile under the mouse cursor. -----
+        public static void DrawTerrainBrushCursor(UltimaBatcher2D batcher, World world)
+        {
+            if (!UI.Gumps.TerrainEditorGump.IsEditing || world?.Map == null || world.Player == null)
+            {
+                return;
+            }
+
+            if (!UIManager.IsMouseOverWorld)
+            {
+                return;
+            }
+
+            if (SelectedObject.Object is not GameObject tile)
+            {
+                return;
+            }
+
+            EnsureFxTextures();
+
+            Vector2 center = TileScreen(world, (ushort)tile.X, (ushort)tile.Y, tile.Z);
+            float tiles = UI.Gumps.TerrainEditorGump.BrushRadius + 0.5f;
+            float rx = tiles * 22f * 1.41421356f;
+            float ry = rx * 0.92f;   // referanstaki imleç neredeyse tam daire, zeminin 2:1 izdüşümü değil
+
+            Color color = UI.Gumps.TerrainEditorGump.CurrentTool switch
+            {
+                UI.Gumps.TerrainEditorGump.TerrainTool.Paint => new Color(120, 200, 255),
+                UI.Gumps.TerrainEditorGump.TerrainTool.Revert => new Color(255, 170, 120),
+                _ => new Color(150, 255, 170)   // the height tools
+            };
+
+            int softness = UI.Gumps.TerrainEditorGump.EdgeSoftness;
+
+            if (UI.Gumps.TerrainEditorGump.SquareBrush)
+            {
+                DrawTileDiamond(batcher, world, tile, UI.Gumps.TerrainEditorGump.BrushRadius, color, 0.85f);
+
+                return;
+            }
+
+            // Referanstaki imleç: içeride yumuşak mavimsi-beyaz bir parıltı, üstünde ince ve keskin beyaz
+            // bir halka. Parıltı ortada en güçlü, halkaya doğru sönüyor.
+            Texture2D disc = GetBrushDisc(batcher.GraphicsDevice);
+
+            if (disc != null)
+            {
+                batcher.Draw(
+                    disc,
+                    new Rectangle((int)(center.X - rx), (int)(center.Y - ry), (int)(rx * 2f), (int)(ry * 2f)),
+                    null,
+                    ShaderHueTranslator.GetHueVector(0, false, 1f),
+                    0f,
+                    Vector2.Zero,
+                    SpriteEffects.None,
+                    0f
+                );
+            }
+
+            // Halka: tek geçiş, ince ve net beyaz (referansta parlama yok, keskin bir çizgi var).
+            DrawEllipseRing(batcher, center, rx, ry, new Random(1), 0f, Color.White, 0f, 0.95f, 2f);
+
+            // Where the brush still applies at full strength: everything between the two rings is the part
+            // that fades out (edge softness).
+            if (softness > 0)
+            {
+                float band = (softness / 100f) * Math.Min(UI.Gumps.TerrainEditorGump.BrushRadius + 0.5f, 6f);
+                float coreScale = Math.Max(0f, (UI.Gumps.TerrainEditorGump.BrushRadius + 0.5f - band) / (UI.Gumps.TerrainEditorGump.BrushRadius + 0.5f));
+
+                if (coreScale > 0.08f)
+                {
+                    DrawEllipseRing(batcher, center, rx * coreScale, ry * coreScale, new Random(1), 0f, color, 0.15f, 0.40f, 2f);
+                }
+            }
+        }
