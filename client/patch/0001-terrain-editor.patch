+        /// <summary>
+        /// MyShard: editörle döşenmiş bir karenin kenarını yumuşatır. Komşu karede başka bir zemin varsa, o
+        /// zeminin solgun bir kopyası ortak kenarda opak, kareye doğru sönerek bu karenin üstüne çizilir.
+        /// Yalnızca BİZİM döşediğimiz karelerin üstüne çizilir: UO'nun kendi dünyası hiç değişmez.
+        /// </summary>
+        private void DrawSoftEdges(UltimaBatcher2D batcher, int posX, int posY, float depth)
+        {
+            if (World?.Map == null || !Managers.TerrainBlendManager.IsCustomGround(Graphic))
+            {
+                return;
+            }
+
+            Vector3 blendHue = ShaderHueTranslator.GetHueVector(0, false, 1f);
+            var pos = new Vector2(posX, posY);
+            int myGroup = Managers.TerrainBlendManager.GetGroup(Graphic);
+
+            for (int side = 0; side < Managers.TerrainBlendManager.SIDE_QTY; side++)
+            {
+                int nx = X, ny = Y;
+
+                switch (side)
+                {
+                    case Managers.TerrainBlendManager.SIDE_WEST: nx--; break;
+                    case Managers.TerrainBlendManager.SIDE_NORTH: ny--; break;
+                    case Managers.TerrainBlendManager.SIDE_EAST: nx++; break;
+                    case Managers.TerrainBlendManager.SIDE_SOUTH: ny++; break;
+                    case Managers.TerrainBlendManager.SIDE_NW: nx--; ny--; break;
+                    case Managers.TerrainBlendManager.SIDE_NE: nx++; ny--; break;
+                    case Managers.TerrainBlendManager.SIDE_SE: nx++; ny++; break;
+                    default: nx--; ny++; break;
+                }
+
+                GameObject obj = World.Map.GetTile(nx, ny, false);
+                Land neighbour = null;
+
+                while (obj != null)
+                {
+                    if (obj is Land land)
+                    {
+                        neighbour = land;
+
+                        break;
+                    }
+
+                    obj = obj.TNext;
+                }
+
+                // Aynı zemin türüyse karıştırılacak bir şey yok (bir setin bütün parçaları tek zemindir).
+                if (neighbour == null || Managers.TerrainBlendManager.GetGroup(neighbour.Graphic) == myGroup)
+                {
+                    continue;
+                }
+
+                Texture2D edge = Managers.TerrainBlendManager.GetEdge(batcher.GraphicsDevice, neighbour.Graphic, side);
+
+                if (edge == null)
+                {
+                    continue;
+                }
+
+                batcher.Draw(
+                    edge,
+                    pos,
+                    null,
+                    blendHue,
+                    0f,
+                    Vector2.Zero,
+                    Vector2.One,
+                    SpriteEffects.None,
+                    // Zeminin belirgin biçimde üstünde ama bir sonraki nesnenin altında: daha küçük bir fark
+                    // derinlik tamponunda çakışıp yürürken titremeye yol açıyordu.
+                    depth + LAND_DEPTH_OFFSET + 0.25f
+                );
+            }
+        }
