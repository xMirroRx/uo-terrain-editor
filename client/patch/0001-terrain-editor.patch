+        /// <summary>
+        /// Makes sure the per-block checksum cache of a map exists. It is normally created when the server
+        /// asks for block hashes; a server that only pushes updates never asks, so create it on demand.
+        /// </summary>
+        private void EnsureMapCRCs(int mapId)
+        {
+            if (MapCRCs == null || mapId < 0 || mapId >= MapCRCs.Length)
+            {
+                return;
+            }
+
+            if (MapCRCs[mapId] != null)
+            {
+                return;
+            }
+
+            int blocks = Client.Game.UO.FileManager.Maps.MapBlocksSize[mapId, 0] * Client.Game.UO.FileManager.Maps.MapBlocksSize[mapId, 1];
+
+            if (blocks <= 0)
+            {
+                return;
+            }
+
+            var crcs = new ushort[blocks];
+
+            for (int i = 0; i < blocks; i++)
+            {
+                crcs[i] = ushort.MaxValue;
+            }
+
+            MapCRCs[mapId] = crcs;
+        }
